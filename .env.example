# 量子密信智能助理凭据（必填）
MIXIN_APP_ID=""
MIXIN_APP_SECRET=""

# 基础运行配置
MIXIN_ENV="production"
MIXIN_AGENT="antigravity"
MIXIN_WORKSPACE="./workspace"
MIXIN_SYSTEM_PROMPT="你是用户的私人助理，用中文简洁回复。"
# 可选：自定义私有部署端点；留空时按 MIXIN_ENV 选择内置地址
MIXIN_API_URL=""
MIXIN_WS_URL=""

# Antigravity CLI（agy >= 1.1.10）
MIXIN_AGY_CLI_PATH=""
MIXIN_AGY_MODEL=""
MIXIN_AGY_EFFORT=""
MIXIN_AGY_AGENT=""
MIXIN_AGY_MODE=""
MIXIN_AGY_PERMISSION="bypass"
MIXIN_AGY_SANDBOX="0"
MIXIN_AGY_TIMEOUT_S="600"

# Claude Code（仅 MIXIN_AGENT=claude 时使用）
MIXIN_CLAUDE_MODEL=""
MIXIN_CLAUDE_CLI_PATH=""
MIXIN_CLAUDE_ALLOWED_TOOLS="Read,Write,Edit,Bash,Glob,Grep"
MIXIN_CLAUDE_PERMISSION="auto"
MIXIN_CLAUDE_DANGER_CONFIRM="1"
MIXIN_CLAUDE_DANGER_PATTERNS=""
# 留空时使用内置的 [[FILE: 绝对路径]] 回传约定
MIXIN_FILE_RETURN_INSTRUCTION=""

# 文件与可选账号配置
MIXIN_MAX_FILE_MB="30"
MIXIN_BOT_USER_ID=""
